# dharma-cli — configuración del backend LLM
# Copia este archivo a .env y rellena tus valores. .env NO se sube a git.

# Endpoint compatible con OpenAI (sin barra final).
# Ollama Cloud (gratis para pruebas): https://ollama.com/v1
# Ollama local:                       http://localhost:11434/v1
# OpenAI oficial:                     https://api.openai.com/v1
DHARMA_BASE_URL=https://ollama.com/v1

# Token Bearer del endpoint.
# Ollama Cloud: tu API key de https://ollama.com/settings/keys
# Ollama local: cualquier valor (lo ignora), p.ej. "ollama"
DHARMA_API_KEY=

# Modelo a usar.
# Ollama Cloud: p.ej. gpt-oss:20b  o  gemma4:cloud  (ids de https://ollama.com/api/tags)
# Ollama local: un modelo que hayas hecho `ollama pull`, p.ej. llama3.2
DHARMA_MODEL=gpt-oss:20b

# Aprobación de herramientas sensibles (shell/escritura/borrado).
# 1 = pedir permiso por la UI (default), 0 = ejecutar directo (pruebas).
DHARMA_APPROVAL=1

# Máximo de rondas de herramientas por turno (freno anti-bucle). Default 25.
# Súbelo si tus tareas de agente necesitan más pasos seguidos.
DHARMA_MAX_ROUNDS=25

# Ventana deslizante del historial: máx. mensajes no-system a conservar entre
# turnos (evita reenviar toda la conversación, caro con API de pago). 0=sin
# límite. Default 40.
DHARMA_MAX_HISTORY=40
