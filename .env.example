# dharma-cli — configuración del backend LLM
# Copia este archivo a .env y rellena tus valores. .env NO se sube a git.

# ─────────────────────────────────────────────────────────────────────────────
# RECOMENDADO: puente ACP hacia `opencode acp` (sin API key propia)
#
# OpenCode ya está autenticado (opencode-go), ya envía x-opencode-session y
# gestiona sesiones/herramientas. dharma solo traduce el dialecto ACP de Kiro
# Crew a ACP v1. No hace falta DHARMA_API_KEY ni DHARMA_BASE_URL.
# ─────────────────────────────────────────────────────────────────────────────
DHARMA_BACKEND=opencode-acp
DHARMA_OPENCODE_BIN=opencode
DHARMA_OPENCODE_MODEL=hungerg-free
# Opcional: prefijo del proveedor para los ids del selector (por defecto opencode-go/)
DHARMA_OPENCODE_MODEL_PREFIX=opencode-go/

# ─────────────────────────────────────────────────────────────────────────────
# ALTERNATIVA: endpoint compatible con OpenAI (Ollama, OpenAI, OpenCode Go HTTP)
# Descomenta estas líneas y pon DHARMA_BACKEND=openai-http arriba.
# OpenCode Go HTTP necesita el header de sesión; dharma lo envía solo.
# ─────────────────────────────────────────────────────────────────────────────
# DHARMA_BACKEND=openai-http
# DHARMA_BASE_URL=https://opencode.ai/inference/go/openai/v1
# DHARMA_API_KEY=oc_sk_...        # tu API key de OpenCode Console
# DHARMA_MODEL=hy4-flash-free
# DHARMA_SESSION_HEADER_NAME=x-opencode-session
# DHARMA_EXTRA_HEADERS={"X-Mi-Header":"valor"}
# DHARMA_USER_AGENT=dharma-cli/0.2.0

# Ejemplos de DHARMA_BASE_URL para otros proveedores:
# Ollama Cloud:                   https://ollama.com/v1
# Ollama local:                   http://localhost:11434/v1
# OpenAI oficial:                 https://api.openai.com/v1

# Aprobación de herramientas sensibles (shell/escritura/borrado) en modo HTTP.
# 1 = pedir permiso por la UI (default), 0 = ejecutar directo (pruebas).
DHARMA_APPROVAL=1

# Máximo de rondas de herramientas por turno (freno anti-bucle). Default 25.
DHARMA_MAX_ROUNDS=25

# Ventana deslizante del historial: máx. mensajes no-system a conservar entre
# turnos (evita reenviar toda la conversación, caro con API de pago). 0=sin
# límite. Default 40.
DHARMA_MAX_HISTORY=40

# Puerto del dashboard en el host (Docker). Default 5477.
DHARMA_PORT=5477

# ── MariaDB opcional (solo si usas: docker compose --profile db up -d) ──
# Cámbialas antes de usar en serio. La DB se expone solo a 127.0.0.1 del host.
DB_ROOT_PASSWORD=changeme
DB_NAME=app
DB_USER=app
DB_PASSWORD=app
DB_PORT=3306
